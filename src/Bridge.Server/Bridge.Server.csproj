<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Bridge.Protocol\Bridge.Protocol.csproj" />
    <ProjectReference Include="..\Bridge.Decode\Bridge.Decode.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Pro Tools launches this exact file name from avx2_plug-ins\ProTools_QuickTime_OPClient.avx. -->
    <AssemblyName>ProToolsQuickTimeServer</AssemblyName>
    <RootNamespace>Bridge.Server</RootNamespace>
    <Version>0.1.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
